{
  "expo": {
    "name": "AnySkill",
    "slug": "anyskill",
    "owner": "baloyitk",
    "scheme": [
      "anyskill",
      "com.anyskill.mobile"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AnySkill uses your location to set your Home Location and match on-site jobs while you are available."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AnySkill needs photo-library access so Providers can submit job-completion evidence."
        }
      ],
      [
        "expo-maps",
        {}
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anyskill.mobile"
    },
    "android": {
      "package": "com.anyskill.mobile"
    },
    "extra": {
      "eas": {
        "projectId": "2927d4f0-8523-4d2c-9c19-7172f7d16d26"
      }
    }
  }
}
