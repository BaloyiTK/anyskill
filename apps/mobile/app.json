{
  "expo": {
    "name": "AnySkill",
    "slug": "anyskill",
    "scheme": ["anyskill", "com.anyskill.mobile"],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AnySkill uses your location to set your Home Location and match on-site jobs while you are available."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AnySkill needs photo-library access so Providers can submit job-completion evidence."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anyskill.mobile"
    },
    "android": {
      "package": "com.anyskill.mobile"
    }
  }
}
