{
  "expo": {
    "name": "AnySkill",
    "slug": "anyskill",
    "scheme": "anyskill",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anyskill.mobile"
    },
    "android": {
      "package": "com.anyskill.mobile"
    }
  }
}
