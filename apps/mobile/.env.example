# Use your computer's LAN IP when testing on a physical device.
# Android emulator default: http://10.0.2.2:3000/api/v1
# iOS simulator default: http://localhost:3000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Google OAuth client IDs from Google Cloud Console (one client per platform).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id
