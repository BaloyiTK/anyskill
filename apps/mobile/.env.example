# Browser and iOS simulator: http://localhost:3000/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
# Physical devices: use your computer's LAN IP.
# The app automatically replaces the Android-emulator URL with localhost on web.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Google OAuth client IDs from Google Cloud Console (one client per platform).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id

# Required for Expo remote push tokens after creating/linking the EAS project
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
# Optional map tile URL template. Configure a production tile provider before release.
# Keep the {z}, {x}, and {y} placeholders and preserve the provider's required attribution.
# EXPO_PUBLIC_MAP_TILE_URL=https://your-tile-provider.example/{z}/{x}/{y}.png
