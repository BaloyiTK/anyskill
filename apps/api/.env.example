# PostgreSQL (local docker-compose defaults)
DATABASE_URL="postgresql://anyskill:anyskill_local_only@localhost:5432/anyskill?schema=public"

# Generate a unique random secret of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Configure an SMTP provider to enable registration, verification and password-reset emails.
# Gmail on port 587 uses STARTTLS, so SMTP_SECURE is false.
SMTP_HOST= smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE= false
SMTP_USER = your-email@gmail.com
SMTP_PASSWORD = your-google-app-password
MAIL_FROM = your-email@gmail.com

# Allowed browser origins, comma-separated. Include each exact local/deployed web origin.
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Google OAuth client IDs: keep the Web client first in the verification allowlist.
# The web client ID is used by the server to redeem browser PKCE authorization codes.
GOOGLE_WEB_CLIENT_ID="your-web-client-id"
# Optional for Google Web OAuth; keep this server-side and never expose it to the mobile app.
GOOGLE_WEB_CLIENT_SECRET=""
GOOGLE_WEB_REDIRECT_URIS="http://localhost:8081"
GOOGLE_OAUTH_CLIENT_IDS="your-web-client-id,your-ios-client-id,your-android-client-id"

# Mobile deep-link scheme
APP_DEEP_LINK="anyskill://"

# Smart Matching (defaults are provisional; response window is configurable)
MATCH_WAVE_SIZE="5"
MATCH_RESPONSE_WINDOW_SECONDS="300"

# Cloudinary authenticated completion evidence
# Preferred format (use the API key and secret from your Cloudinary Console):
CLOUDINARY_URL="cloudinary://<your_api_key>:<your_api_secret>@dgjzyis2j"
# Alternatively, configure all three split variables instead:
# CLOUDINARY_CLOUD_NAME="dgjzyis2j"
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Server-side key restricted to Places API (New) and Geocoding API.
GOOGLE_PLACES_API_KEY=


# PayFast sandbox only. Never commit real merchant credentials or encryption keys.
# Create a sandbox account at https://sandbox.payfast.co.za and set a security passphrase.
PAYFAST_MODE="sandbox"
# Set to the exact number of trusted reverse-proxy hops in front of Express (0 for direct access; often 1 for a single HTTPS tunnel/proxy).
TRUST_PROXY_HOPS="0"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
# Public HTTPS base URL of this API (must be reachable by PayFast for ITN callbacks).
PAYFAST_PUBLIC_API_URL="https://your-public-api.example.com"
# Public app/web destinations after PayFast returns or cancels checkout.
PAYFAST_RETURN_URL="https://your-app.example.com/payments/payfast/return"
PAYFAST_CANCEL_URL="https://your-app.example.com/payments/payfast/cancel"
# 32+ character random secret used to encrypt saved PayFast tokens at rest.
PAYFAST_TOKEN_ENCRYPTION_KEY=""
