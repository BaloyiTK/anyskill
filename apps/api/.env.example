# PostgreSQL (local docker-compose defaults)
DATABASE_URL="postgresql://anyskill:anyskill_local_only@localhost:5432/anyskill?schema=public"

# Generate a unique random secret of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Configure an SMTP provider to enable registration, verification and password-reset emails.
# Leave SMTP_HOST empty until a provider is configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AnySkill <no-reply@example.com>"

# Allowed browser origins, comma-separated. Include each exact local/deployed web origin.
CORS_ALLOWED_ORIGINS="http://localhost:8081"

# Google OAuth client IDs: keep the Web client first in the verification allowlist.
# The web client ID is used by the server to redeem browser PKCE authorization codes.
GOOGLE_WEB_CLIENT_ID="your-web-client-id"
# Optional for Google Web OAuth; keep this server-side and never expose it to the mobile app.
GOOGLE_WEB_CLIENT_SECRET=""
GOOGLE_WEB_REDIRECT_URIS="http://localhost:8081"
GOOGLE_OAUTH_CLIENT_IDS="your-web-client-id,your-ios-client-id,your-android-client-id"

# Mobile deep-link scheme
APP_DEEP_LINK="anyskill://"

# Smart Matching (defaults are provisional; response window is configurable)
MATCH_WAVE_SIZE="5"
MATCH_RESPONSE_WINDOW_SECONDS="300"

# Cloudinary authenticated completion evidence
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
