# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anyskill?schema=public"

# Generate a unique random secret of at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Email delivery (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AnySkill <no-reply@example.com>"

# Allowed browser origins, comma-separated. Leave empty for native-only local development.
CORS_ALLOWED_ORIGINS=""

# Mobile deep-link scheme
APP_DEEP_LINK="anyskill://"
