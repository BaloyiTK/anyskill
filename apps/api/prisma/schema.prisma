generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_INFORMATION
  UNDER_REVIEW
  SUSPENDED
  REVOKED
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  CANCELLED
}


enum ServiceRequestStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ProviderResponseStatus {
  OFFERED
  WITHDRAWN
  DECLINED
  SELECTED
}

enum ServiceDeliveryMode {
  ONSITE
  REMOTE
  EITHER
}

enum RequestMatchStatus {
  NOTIFIED
  RESPONDED
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  IN_APP_ONLY
  FAILED
}

model User {
  id                       String                      @id @default(uuid()) @db.Uuid
  email                    String                      @unique @db.VarChar(320)
  phone                    String?                     @unique @db.VarChar(32)
  googleSubject            String?                     @unique @map("google_subject") @db.VarChar(255)
  passwordHash             String                      @map("password_hash")
  emailVerifiedAt          DateTime?                   @map("email_verified_at")
  identityVerification     IdentityVerificationStatus  @default(NOT_STARTED) @map("identity_verification_status")
  identityVerifiedAt       DateTime?                   @map("identity_verified_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  identityCases            IdentityVerificationCase[]
  serviceRequests          ServiceRequest[]
  providerResponses        ProviderResponse[]
  providerProfile          ProviderProfile?
  pushDevices              PushDevice[]
  notifications            AppNotification[]

  @@index([identityVerification])
  @@map("users")
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerificationCase {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @db.Uuid @map("user_id")
  status                VerificationCaseStatus @default(SUBMITTED)
  provider              String?                @db.VarChar(80)
  providerReference     String?                @map("provider_reference") @db.VarChar(255)
  submittedAt           DateTime               @default(now()) @map("submitted_at")
  reviewedAt            DateTime?              @map("reviewed_at")
  reviewerId            String?                @db.Uuid @map("reviewer_id")
  decisionReason        String?                @map("decision_reason") @db.VarChar(1000)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("identity_verification_cases")
}

 
model ServiceRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  seekerId           String                @db.Uuid @map("seeker_id")
  title              String                @db.VarChar(120)
  skillCategory      String                @map("skill_category") @db.VarChar(100)
  description        String                @db.VarChar(5000)
  imageUrls          String[]              @default([]) @map("image_urls")
  location           String?               @db.VarChar(500)
  deliveryMode       ServiceDeliveryMode   @map("delivery_mode")
  preferredStartAt   DateTime?             @map("preferred_start_at")
  instructions       String?               @db.VarChar(2000)
  status             ServiceRequestStatus  @default(OPEN)
  matchingWave       Int                   @default(0) @map("matching_wave")
  matchingNextAt     DateTime?             @map("matching_next_at")
  matchingExhaustedAt DateTime?            @map("matching_exhausted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  seeker             User                  @relation(fields: [seekerId], references: [id], onDelete: Restrict)
  providerResponses ProviderResponse[]
  matches           RequestMatch[]

  @@index([status, createdAt])
  @@index([seekerId, createdAt])
  @@map("service_requests")
}

model ProviderResponse {
  id          String                 @id @default(uuid()) @db.Uuid
  requestId   String                 @db.Uuid @map("request_id")
  providerId  String                 @db.Uuid @map("provider_id")
  status      ProviderResponseStatus @default(OFFERED)
  message     String?                @db.VarChar(2000)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  request     ServiceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User                   @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, status])
  @@map("provider_responses")
}

 
model ProviderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid @map("user_id")
  skillCategories String[] @default([]) @map("skill_categories")
  serviceAreas    String[] @default([]) @map("service_areas")
  deliveryModes   String[] @default(["ONSITE"]) @map("delivery_modes")
  isAvailable     Boolean  @default(false) @map("is_available")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@map("provider_profiles")
}

model RequestMatch {
  id          String            @id @default(uuid()) @db.Uuid
  requestId   String            @db.Uuid @map("request_id")
  providerId  String            @db.Uuid @map("provider_id")
  score       Int
  wave        Int
  status      RequestMatchStatus @default(NOTIFIED)
  notifiedAt  DateTime          @default(now()) @map("notified_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  request     ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, wave])
  @@map("request_matches")
}

model PushDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  expoPushToken String  @unique @map("expo_push_token") @db.VarChar(255)
  platform     String   @db.VarChar(30)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model AppNotification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid @map("user_id")
  title          String                    @db.VarChar(120)
  body           String                    @db.VarChar(500)
  data           Json?
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  attempts       Int                       @default(0)
  readAt         DateTime?                 @map("read_at")
  sentAt         DateTime?                 @map("sent_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([deliveryStatus, createdAt])
  @@map("app_notifications")
}
