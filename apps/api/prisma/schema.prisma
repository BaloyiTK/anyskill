generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RegistrationMode {
  SEEKER
  PROVIDER
}

enum MarketplaceRoleStatus {
  NOT_REQUESTED
  PENDING
  ACTIVE
  REJECTED
  REQUIRES_INFORMATION
  SUSPENDED
}

enum ProviderApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

enum ProviderSkillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StaffRole {
  PROVIDER_REVIEWER
  IDENTITY_REVIEWER
  SUPPORT_AGENT
  FINANCE_OFFICER
  FRAUD_OFFICER
  ADMIN
  SUPER_ADMIN
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_INFORMATION
  UNDER_REVIEW
  SUSPENDED
  REVOKED
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  CANCELLED
}


enum ServiceRequestStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ProviderResponseStatus {
  OFFERED
  WITHDRAWN
  DECLINED
  SELECTED
}

enum ServiceDeliveryMode {
  ONSITE
  REMOTE
  EITHER
}

enum RequestMatchStatus {
  NOTIFIED
  RESPONDED
  EXPIRED
}

enum JobEngagementStatus {
  ASSESSMENT_PENDING
  ESTIMATE_SUBMITTED
  ESTIMATE_REJECTED
  ESTIMATE_APPROVED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  DISPUTED
}

enum CostAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobCompletionSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaAssetStatus {
  PENDING
  VERIFYING
  READY
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  IN_APP_ONLY
  FAILED
}

enum PushReceiptStatus {
  PENDING
  OK
  ERROR
}
enum PaymentMethodStatus {
  SETUP_PENDING
  ACTIVE
  REQUIRES_UPDATE
  REMOVED
}
enum PaymentStatus {
  PENDING
  AUTHORIZATION_PENDING
  AUTHORIZED
  CAPTURE_PENDING
  CAPTURED
  FAILED
  CANCELLED
  RECONCILIATION_REQUIRED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum PaymentOperationType {
  AUTHORIZE
  CAPTURE
  VOID
  REFUND
}
enum PaymentOperationStatus {
  PENDING
  SUCCEEDED
  FAILED
  UNKNOWN
}
enum PaymentWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}
enum ProviderPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REVERSED
}
enum LedgerDirection {
  DEBIT
  CREDIT
}


model PushNotificationReceipt {
  id             String            @id @default(uuid()) @db.Uuid
  notificationId String            @db.Uuid @map("notification_id")
  pushDeviceId   String            @db.Uuid @map("push_device_id")
  expoTicketId   String            @unique @map("expo_ticket_id") @db.VarChar(255)
  status         PushReceiptStatus @default(PENDING)
  errorCode      String?           @map("error_code") @db.VarChar(100)
  errorMessage   String?           @map("error_message") @db.VarChar(500)
  checkedAt      DateTime?          @map("checked_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  notification   AppNotification    @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushDevice     PushDevice         @relation(fields: [pushDeviceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("push_notification_receipts")
}

model User {
  id                       String                      @id @default(uuid()) @db.Uuid
  email                    String                      @unique @db.VarChar(320)
  phone                    String?                     @unique @db.VarChar(32)
  googleSubject            String?                     @unique @map("google_subject") @db.VarChar(255)
  initialMode              RegistrationMode            @default(SEEKER) @map("initial_mode")
  seekerRoleStatus         MarketplaceRoleStatus       @default(ACTIVE) @map("seeker_role_status")
  providerRoleStatus       MarketplaceRoleStatus       @default(NOT_REQUESTED) @map("provider_role_status")
  activeMarketplaceMode    RegistrationMode?           @default(SEEKER) @map("active_marketplace_mode")
  homeLocationLabel         String?                      @map("home_location_label") @db.VarChar(500)
  homeLatitude              Float?                       @map("home_latitude")
  homeLongitude             Float?                       @map("home_longitude")
  passwordHash             String                      @map("password_hash")
  emailVerifiedAt          DateTime?                   @map("email_verified_at")
  identityVerification     IdentityVerificationStatus  @default(NOT_STARTED) @map("identity_verification_status")
  identityVerifiedAt       DateTime?                   @map("identity_verified_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  deletedAt                DateTime?                   @map("deleted_at")
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  passwordResetOtp         PasswordResetOtp?
  identityCases            IdentityVerificationCase[]
  serviceRequests          ServiceRequest[]
  providerResponses        ProviderResponse[]
  providerProfile          ProviderProfile?
  providerSkills           ProviderSkill[]
  pushDevices              PushDevice[]
  notifications            AppNotification[]
  mediaAssets              MediaAsset[]
  onboardingDraft           OnboardingDraft?
  providerRoleApplication   ProviderRoleApplication?   @relation("ProviderApplicationApplicant")
  reviewedProviderApplications ProviderRoleApplication[] @relation("ProviderApplicationReviewer")
  staffMembership           StaffMembership?
  staffActions              StaffAuditLog[]             @relation("StaffAuditActor")
  staffTargets              StaffAuditLog[]             @relation("StaffAuditTarget")
  providerReviewsReceived   ProviderReview[]             @relation("ProviderReviewsReceived")
  providerReviewsGiven      ProviderReview[]             @relation("ProviderReviewsGiven")
  paymentMethods            PaymentMethod[]
  seekerPayments            Payment[]                    @relation("PaymentSeeker")
  providerPayments          Payment[]                    @relation("PaymentProvider")
  providerPayouts            ProviderPayout[]
  seekerReviewsReceived     SeekerReview[]                @relation("SeekerReviewsReceived")
  seekerReviewsGiven        SeekerReview[]                @relation("SeekerReviewsGiven")

  @@index([identityVerification])
  @@map("users")
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  tokenFamilyId String  @db.Uuid @map("token_family_id")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenFamilyId, revokedAt])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetOtp {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid @map("user_id")
  otpHash           String   @map("otp_hash") @db.VarChar(64)
  attempts          Int      @default(0)
  expiresAt         DateTime @map("expires_at")
  resendAvailableAt DateTime @map("resend_available_at")
  consumedAt        DateTime? @map("consumed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_otps")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerificationCase {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @db.Uuid @map("user_id")
  status                VerificationCaseStatus @default(SUBMITTED)
  provider              String?                @db.VarChar(80)
  providerReference     String?                @map("provider_reference") @db.VarChar(255)
  submittedAt           DateTime               @default(now()) @map("submitted_at")
  reviewedAt            DateTime?              @map("reviewed_at")
  reviewerId            String?                @db.Uuid @map("reviewer_id")
  decisionReason        String?                @map("decision_reason") @db.VarChar(1000)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("identity_verification_cases")
}

 
model ServiceRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  seekerId           String?               @db.Uuid @map("seeker_id")
  idempotencyKey     String?               @db.VarChar(100) @map("idempotency_key")
  idempotencyPayloadHash String?           @db.Char(64) @map("idempotency_payload_hash")
  title              String                @db.VarChar(120)
  skillCategory      String                @map("skill_category") @db.VarChar(100)
  description        String                @db.VarChar(5000)
  imageUrls          String[]              @default([]) @map("image_urls")
  location           String?               @db.VarChar(500)
  latitude           Float?
  longitude          Float?
  searchRadiusKm      Int                   @default(10) @map("search_radius_km")
  deliveryMode       ServiceDeliveryMode   @map("delivery_mode")
  preferredStartAt   DateTime?             @map("preferred_start_at")
  instructions       String?               @db.VarChar(2000)
  status             ServiceRequestStatus  @default(OPEN)
  matchingStartedAt  DateTime              @default(now()) @map("matching_started_at")
  matchingWave       Int                   @default(0) @map("matching_wave")
  matchingNextAt     DateTime?             @map("matching_next_at")
  matchingExhaustedAt DateTime?            @map("matching_exhausted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  seeker             User?                 @relation(fields: [seekerId], references: [id], onDelete: SetNull)
  providerResponses ProviderResponse[]
  matches           RequestMatch[]
  jobEngagement     JobEngagement?

  @@index([status, createdAt])
  @@index([seekerId, createdAt])
  @@unique([seekerId, idempotencyKey])
  @@map("service_requests")
}

model ProviderResponse {
  id          String                 @id @default(uuid()) @db.Uuid
  requestId   String                 @db.Uuid @map("request_id")
  providerId  String?                @db.Uuid @map("provider_id")
  status      ProviderResponseStatus @default(OFFERED)
  message     String?                @db.VarChar(2000)
  hourlyRateAtOffer Decimal?           @map("hourly_rate_at_offer") @db.Decimal(10, 2)
  assessmentFeeAtOffer Decimal?        @map("assessment_fee_at_offer") @db.Decimal(10, 2)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  request     ServiceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User?                  @relation(fields: [providerId], references: [id], onDelete: SetNull)
  jobEngagement JobEngagement?

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, status])
  @@map("provider_responses")
}

 
model ProviderSkill {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @db.Uuid @map("user_id")
  category       String             @db.VarChar(100)
  details        Json?
  status         ProviderSkillStatus @default(PENDING)
  decisionReason String?            @map("decision_reason") @db.VarChar(1000)
  reviewerId     String?            @db.Uuid @map("reviewer_id")
  submittedAt    DateTime           @default(now()) @map("submitted_at")
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([status, submittedAt])
  @@index([userId, status])
  @@map("provider_skills")
}

model ProviderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid @map("user_id")
  publicName      String   @default("") @map("public_name") @db.VarChar(80)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  assessmentFee   Decimal  @default(0) @map("assessment_fee") @db.Decimal(10, 2)
  skillCategories String[] @default([]) @map("skill_categories")
  normalizedSkillKeys String[] @default([]) @map("normalized_skill_keys")
  serviceAreas    String[] @default([]) @map("service_areas")
  deliveryModes   String[] @default(["ONSITE"]) @map("delivery_modes")
  isAvailable     Boolean  @default(false) @map("is_available")
  liveLatitude    Float?   @map("live_latitude")
  liveLongitude   Float?   @map("live_longitude")
  liveAccuracyM   Float?   @map("live_accuracy_m")
  liveLocationUpdatedAt DateTime? @map("live_location_updated_at")
  maxTravelDistanceKm Float @default(25) @map("max_travel_distance_km")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([normalizedSkillKeys], type: Gin)
  @@index([isAvailable])
  @@map("provider_profiles")
}

model RequestMatch {
  id          String            @id @default(uuid()) @db.Uuid
  requestId   String            @db.Uuid @map("request_id")
  providerId  String?           @db.Uuid @map("provider_id")
  score       Int
  wave        Int
  status      RequestMatchStatus @default(NOTIFIED)
  notifiedAt  DateTime          @default(now()) @map("notified_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  request     ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, wave])
  @@map("request_matches")
}

model PushDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  expoPushToken String  @unique @map("expo_push_token") @db.VarChar(255)
  platform     String   @db.VarChar(30)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushReceipts PushNotificationReceipt[]

  @@index([userId])
  @@map("push_devices")
}

model AppNotification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid @map("user_id")
  title          String                    @db.VarChar(120)
  body           String                    @db.VarChar(500)
  data           Json?
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  attempts       Int                       @default(0)
  readAt         DateTime?                 @map("read_at")
  sentAt         DateTime?                 @map("sent_at")
  sendingStartedAt DateTime?               @map("sending_started_at")
  nextAttemptAt  DateTime                  @default(now()) @map("next_attempt_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushReceipts   PushNotificationReceipt[]

  @@index([userId, readAt, createdAt])
  @@index([deliveryStatus, nextAttemptAt, createdAt])
  @@map("app_notifications")
}


model JobEngagement {
  id                    String              @id @default(uuid()) @db.Uuid
  requestId             String              @unique @db.Uuid @map("request_id")
  responseId            String              @unique @db.Uuid @map("response_id")
  seekerId              String?             @db.Uuid @map("seeker_id")
  providerId            String?             @db.Uuid @map("provider_id")
  status                JobEngagementStatus @default(ASSESSMENT_PENDING)
  hourlyRate            Decimal             @map("hourly_rate") @db.Decimal(10, 2)
  assessmentFee         Decimal             @default(0) @map("assessment_fee") @db.Decimal(10, 2)
  estimatedHours       Decimal?            @map("estimated_hours") @db.Decimal(8, 2)
  estimatedTotal       Decimal?            @map("estimated_total") @db.Decimal(10, 2)
  estimateNotes        String?             @map("estimate_notes") @db.VarChar(2000)
  estimateDecisionNote String?             @map("estimate_decision_note") @db.VarChar(1000)
  estimateSubmittedAt DateTime?            @map("estimate_submitted_at")
  estimateDecidedAt   DateTime?            @map("estimate_decided_at")
  workStartedAt          DateTime? @map("work_started_at")
  workAccumulatedMs       Int       @default(0) @map("work_accumulated_ms")
  workSegmentStartedAt    DateTime? @map("work_segment_started_at")
  workPausedAt            DateTime? @map("work_paused_at")
  workEndedAt             DateTime? @map("work_ended_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  request             ServiceRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response            ProviderResponse     @relation(fields: [responseId], references: [id], onDelete: Restrict)
  adjustments         JobCostAdjustment[]
  completionSubmissions JobCompletionSubmission[]
  review                ProviderReview?
  seekerReview          SeekerReview?
  payment               Payment?
  @@index([seekerId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@map("job_engagements")
}

model SeekerReview {
  id           String        @id @default(uuid()) @db.Uuid
  engagementId String        @unique @db.Uuid @map("engagement_id")
  providerId   String        @db.Uuid @map("provider_id")
  seekerId     String        @db.Uuid @map("seeker_id")
  rating       Int
  comment      String?       @db.VarChar(1500)
  createdAt    DateTime      @default(now()) @map("created_at")
  engagement  JobEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  provider    User          @relation("SeekerReviewsGiven", fields: [providerId], references: [id], onDelete: Cascade)
  seeker      User          @relation("SeekerReviewsReceived", fields: [seekerId], references: [id], onDelete: Cascade)

  @@index([seekerId, createdAt])
  @@index([providerId, createdAt])
  @@map("seeker_reviews")
}

model JobCostAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  engagementId    String                @db.Uuid @map("engagement_id")
  requestedHours  Decimal               @map("requested_hours") @db.Decimal(8, 2)
  hourlyRate      Decimal               @map("hourly_rate") @db.Decimal(10, 2)
  requestedAmount Decimal               @map("requested_amount") @db.Decimal(10, 2)
  reason          String                @db.VarChar(1000)
  status          CostAdjustmentStatus  @default(PENDING)
  decisionNote    String?               @map("decision_note") @db.VarChar(1000)
  decidedAt       DateTime?             @map("decided_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  engagement      JobEngagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  @@index([engagementId, status, createdAt])
  @@map("job_cost_adjustments")
}


model JobCompletionSubmission {
  id             String                           @id @default(uuid()) @db.Uuid
  engagementId   String                           @db.Uuid @map("engagement_id")
  idempotencyKey String?                          @db.VarChar(100) @map("idempotency_key")
  idempotencyPayloadHash String?                  @db.Char(64) @map("idempotency_payload_hash")
  providerId     String?                          @db.Uuid @map("provider_id")
  notes          String                           @db.VarChar(3000)
  evidenceUrls   String[]                         @default([]) @map("evidence_urls")
  evidenceAssets MediaAsset[]
  status         JobCompletionSubmissionStatus    @default(PENDING)
  reviewNote     String?                          @map("review_note") @db.VarChar(1000)
  submittedAt    DateTime                         @default(now()) @map("submitted_at")
  reviewedAt     DateTime?                        @map("reviewed_at")
  engagement     JobEngagement                    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  @@unique([engagementId, idempotencyKey])
  @@index([engagementId, status, submittedAt])
  @@map("job_completion_submissions")
}


model MediaAsset {
  id                     String                       @id @default(uuid()) @db.Uuid
  userId                 String                       @db.Uuid @map("user_id")
  idempotencyKey         String?                      @db.VarChar(100) @map("idempotency_key")
  idempotencyPayloadHash String?                      @db.Char(64) @map("idempotency_payload_hash")
  objectKey              String                       @unique @map("object_key") @db.VarChar(512)
  originalName            String                       @map("original_name") @db.VarChar(255)
  contentType             String                       @map("content_type") @db.VarChar(100)
  sizeBytes               Int                          @map("size_bytes")
  purpose                 String                       @db.VarChar(50)
  status                  MediaAssetStatus             @default(PENDING)
  expiresAt               DateTime                     @map("expires_at")
  uploadedAt              DateTime?                    @map("uploaded_at")
  verificationStartedAt   DateTime?                    @map("verification_started_at")
  completionSubmissionId  String?                      @db.Uuid @map("completion_submission_id")
  createdAt               DateTime                     @default(now()) @map("created_at")
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionSubmission    JobCompletionSubmission?     @relation(fields: [completionSubmissionId], references: [id], onDelete: SetNull)
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
  @@unique([userId, idempotencyKey])
  @@index([completionSubmissionId])
  @@map("media_assets")
}


model PendingRegistration {
 id String @id @default(uuid()) @db.Uuid
 email String @unique @db.VarChar(320)
 mode RegistrationMode
 otpHash String @map("otp_hash") @db.VarChar(64)
 attempts Int @default(0)
 expiresAt DateTime @map("expires_at")
 resendAvailableAt DateTime @map("resend_available_at")
 verifiedAt DateTime? @map("verified_at")
 registrationTokenHash String? @unique @map("registration_token_hash") @db.VarChar(64)
 registrationTokenExpiresAt DateTime? @map("registration_token_expires_at")
 createdAt DateTime @default(now()) @map("created_at")
 updatedAt DateTime @updatedAt @map("updated_at")
 @@index([expiresAt])
 @@map("pending_registrations")
}


model OnboardingDraft {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid @map("user_id")
  profile Json?
  skills Json?
  portfolio Json?
  submittedAt DateTime? @map("submitted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("onboarding_drafts")
}

model ProviderRoleApplication {
  id              String                    @id @default(uuid()) @db.Uuid
  userId          String                    @unique @db.Uuid @map("user_id")
  status          ProviderApplicationStatus @default(PENDING)
  applicationData Json                      @map("application_data")
  submittedAt     DateTime                  @default(now()) @map("submitted_at")
  reviewedAt      DateTime?                 @map("reviewed_at")
  reviewerId      String?                   @db.Uuid @map("reviewer_id")
  decisionReason  String?                   @map("decision_reason") @db.VarChar(1000)
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  user            User                      @relation("ProviderApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer        User?                     @relation("ProviderApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([reviewerId, reviewedAt])
  @@map("provider_role_applications")
}

model StaffMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid @map("user_id")
  role      StaffRole
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, isActive])
  @@map("staff_memberships")
}

model StaffAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String   @db.Uuid @map("actor_id")
  targetUserId String   @db.Uuid @map("target_user_id")
  action       String   @db.VarChar(80)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  actor        User     @relation("StaffAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User     @relation("StaffAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
  @@map("staff_audit_logs")
}


model ProviderReview {
  id            String        @id @default(uuid()) @db.Uuid
  engagementId  String        @unique @db.Uuid @map("engagement_id")
  seekerId      String        @db.Uuid @map("seeker_id")
  providerId    String        @db.Uuid @map("provider_id")
  skillCategory String        @map("skill_category") @db.VarChar(100)
  skillRating   Int           @map("skill_rating")
  platformRating Int          @map("platform_rating")
  comment       String?       @db.VarChar(1500)
  createdAt     DateTime      @default(now()) @map("created_at")
  engagement    JobEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  seeker        User          @relation("ProviderReviewsGiven", fields: [seekerId], references: [id], onDelete: Cascade)
  provider      User          @relation("ProviderReviewsReceived", fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, skillCategory, createdAt])
  @@index([providerId, createdAt])
  @@map("provider_reviews")
}


// Financial records are retained independently of user account lifecycle.
// All amounts are integer minor units (for ZAR, cents); never use float money.
model PaymentMethod {
  id                       String              @id @default(uuid()) @db.Uuid
  userId                   String              @db.Uuid @map("user_id")
  provider                 String              @default("PAYGATE") @db.VarChar(40)
  gatewayMethodReference   String              @unique @map("gateway_method_reference") @db.VarChar(255)
  gatewayCustomerReference String?             @map("gateway_customer_reference") @db.VarChar(255)
  encryptedToken           String              @map("encrypted_token") @db.Text
  encryptionKeyVersion     String              @map("encryption_key_version") @db.VarChar(80)
  brand                    String?             @db.VarChar(40)
  last4                    String?             @db.Char(4)
  status                   PaymentMethodStatus @default(SETUP_PENDING)
  consentAt                DateTime            @map("consent_at")
  consentVersion           String              @map("consent_version") @db.VarChar(40)
  createdAt                DateTime            @default(now()) @map("created_at")
  updatedAt                DateTime            @updatedAt @map("updated_at")
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments                 Payment[]
  @@index([userId, status])
  @@map("payment_methods")
}

model Payment {
  id                          String        @id @default(uuid()) @db.Uuid
  engagementId                String        @unique @db.Uuid @map("engagement_id")
  seekerId                    String?       @db.Uuid @map("seeker_id")
  providerId                  String?       @db.Uuid @map("provider_id")
  paymentMethodId             String?       @db.Uuid @map("payment_method_id")
  currency                    String        @default("ZAR") @db.Char(3)
  estimateVersion             Int           @map("estimate_version")
  amountAuthorizedMinor       BigInt?       @map("amount_authorized_minor")
  amountCapturedMinor         BigInt?       @map("amount_captured_minor")
  status                      PaymentStatus @default(PENDING)
  gatewayTransactionReference String?       @unique @map("gateway_transaction_reference") @db.VarChar(255)
  authorizedAt                DateTime?     @map("authorized_at")
  capturedAt                  DateTime?     @map("captured_at")
  createdAt                   DateTime      @default(now()) @map("created_at")
  updatedAt                   DateTime      @updatedAt @map("updated_at")
  engagement                  JobEngagement @relation(fields: [engagementId], references: [id], onDelete: Restrict)
  seeker                      User?         @relation("PaymentSeeker", fields: [seekerId], references: [id], onDelete: SetNull)
  provider                    User?         @relation("PaymentProvider", fields: [providerId], references: [id], onDelete: SetNull)
  paymentMethod               PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  operations                  PaymentOperation[]
  ledgerEntries               FinancialLedgerEntry[]
  @@index([seekerId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@index([status, updatedAt])
  @@map("payments")
}

model PaymentOperation {
  id               String                 @id @default(uuid()) @db.Uuid
  paymentId        String                 @db.Uuid @map("payment_id")
  type             PaymentOperationType
  status           PaymentOperationStatus @default(PENDING)
  idempotencyKey   String                 @unique @map("idempotency_key") @db.VarChar(120)
  requestHash      String                 @map("request_hash") @db.Char(64)
  amountMinor      BigInt                 @map("amount_minor")
  currency         String                 @db.Char(3)
  gatewayReference String?                @unique @map("gateway_reference") @db.VarChar(255)
  failureCode      String?                @map("failure_code") @db.VarChar(100)
  safeResponse     Json?                  @map("safe_response")
  requestedAt      DateTime               @default(now()) @map("requested_at")
  completedAt      DateTime?              @map("completed_at")
  payment          Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([paymentId, type, status])
  @@index([status, requestedAt])
  @@map("payment_operations")
}

model PaymentWebhookEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  provider           String               @db.VarChar(40)
  providerEventId    String               @map("provider_event_id") @db.VarChar(255)
  payloadHash        String               @map("payload_hash") @db.Char(64)
  normalizedPayload Json                 @map("normalized_payload")
  signatureVerified Boolean              @default(false) @map("signature_verified")
  status             PaymentWebhookStatus @default(RECEIVED)
  attempts           Int                  @default(0)
  receivedAt         DateTime             @default(now()) @map("received_at")
  processedAt        DateTime?            @map("processed_at")
  lastError          String?              @map("last_error") @db.VarChar(500)
  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

model ProviderPayout {
  id                String               @id @default(uuid()) @db.Uuid
  providerId        String?              @db.Uuid @map("provider_id")
  amountMinor       BigInt               @map("amount_minor")
  currency          String               @db.Char(3)
  status            ProviderPayoutStatus @default(PENDING)
  idempotencyKey    String               @unique @map("idempotency_key") @db.VarChar(120)
  payoutRail        String               @map("payout_rail") @db.VarChar(60)
  externalReference String?              @unique @map("external_reference") @db.VarChar(255)
  failureCode       String?              @map("failure_code") @db.VarChar(100)
  requestedAt       DateTime             @default(now()) @map("requested_at")
  completedAt       DateTime?            @map("completed_at")
  provider          User?                @relation(fields: [providerId], references: [id], onDelete: SetNull)
  @@index([providerId, status, requestedAt])
  @@index([status, requestedAt])
  @@map("provider_payouts")
}

model FinancialLedgerEntry {
  id             String         @id @default(uuid()) @db.Uuid
  entryGroupId   String         @map("entry_group_id") @db.Uuid
  paymentId      String?        @db.Uuid @map("payment_id")
  accountCode    String         @map("account_code") @db.VarChar(80)
  direction      LedgerDirection
  amountMinor    BigInt         @map("amount_minor")
  currency       String         @db.Char(3)
  idempotencyKey String         @unique @map("idempotency_key") @db.VarChar(160)
  description    String         @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  payment        Payment?       @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  @@index([entryGroupId])
  @@index([paymentId, createdAt])
  @@index([accountCode, currency, createdAt])
  @@map("financial_ledger_entries")
}
