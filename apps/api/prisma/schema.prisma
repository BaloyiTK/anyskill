generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_INFORMATION
  UNDER_REVIEW
  SUSPENDED
  REVOKED
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  CANCELLED
}


enum ServiceRequestStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ProviderResponseStatus {
  OFFERED
  WITHDRAWN
  DECLINED
  SELECTED
}

enum ServiceDeliveryMode {
  ONSITE
  REMOTE
  EITHER
}

model User {
  id                       String                      @id @default(uuid()) @db.Uuid
  email                    String                      @unique @db.VarChar(320)
  phone                    String?                     @unique @db.VarChar(32)
  googleSubject            String?                     @unique @map("google_subject") @db.VarChar(255)
  passwordHash             String                      @map("password_hash")
  emailVerifiedAt          DateTime?                   @map("email_verified_at")
  identityVerification     IdentityVerificationStatus  @default(NOT_STARTED) @map("identity_verification_status")
  identityVerifiedAt       DateTime?                   @map("identity_verified_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  identityCases            IdentityVerificationCase[]
  serviceRequests          ServiceRequest[]
  providerResponses        ProviderResponse[]

  @@index([identityVerification])
  @@map("users")
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerificationCase {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @db.Uuid @map("user_id")
  status                VerificationCaseStatus @default(SUBMITTED)
  provider              String?                @db.VarChar(80)
  providerReference     String?                @map("provider_reference") @db.VarChar(255)
  submittedAt           DateTime               @default(now()) @map("submitted_at")
  reviewedAt            DateTime?              @map("reviewed_at")
  reviewerId            String?                @db.Uuid @map("reviewer_id")
  decisionReason        String?                @map("decision_reason") @db.VarChar(1000)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("identity_verification_cases")
}

 
model ServiceRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  seekerId           String                @db.Uuid @map("seeker_id")
  title              String                @db.VarChar(120)
  skillCategory      String                @map("skill_category") @db.VarChar(100)
  description        String                @db.VarChar(5000)
  imageUrls          String[]              @default([]) @map("image_urls")
  location           String?               @db.VarChar(500)
  deliveryMode       ServiceDeliveryMode   @map("delivery_mode")
  preferredStartAt   DateTime?             @map("preferred_start_at")
  instructions       String?               @db.VarChar(2000)
  status             ServiceRequestStatus  @default(OPEN)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  seeker             User                  @relation(fields: [seekerId], references: [id], onDelete: Restrict)
  providerResponses ProviderResponse[]

  @@index([status, createdAt])
  @@index([seekerId, createdAt])
  @@map("service_requests")
}

model ProviderResponse {
  id          String                 @id @default(uuid()) @db.Uuid
  requestId   String                 @db.Uuid @map("request_id")
  providerId  String                 @db.Uuid @map("provider_id")
  status      ProviderResponseStatus @default(OFFERED)
  message     String?                @db.VarChar(2000)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  request     ServiceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User                   @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, status])
  @@map("provider_responses")
}
