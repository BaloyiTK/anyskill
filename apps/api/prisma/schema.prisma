generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  REQUIRES_INFORMATION
  UNDER_REVIEW
  SUSPENDED
  REVOKED
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFORMATION
  CANCELLED
}


enum ServiceRequestStatus {
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ProviderResponseStatus {
  OFFERED
  WITHDRAWN
  DECLINED
  SELECTED
}

enum ServiceDeliveryMode {
  ONSITE
  REMOTE
  EITHER
}

enum RequestMatchStatus {
  NOTIFIED
  RESPONDED
  EXPIRED
}

enum JobEngagementStatus {
  ASSESSMENT_PENDING
  ESTIMATE_SUBMITTED
  ESTIMATE_REJECTED
  ESTIMATE_APPROVED
  IN_PROGRESS
  COMPLETION_PENDING
  COMPLETED
  DISPUTED
}

enum CostAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobCompletionSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MediaAssetStatus {
  PENDING
  READY
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  SENDING
  SENT
  IN_APP_ONLY
  FAILED
}

model User {
  id                       String                      @id @default(uuid()) @db.Uuid
  email                    String                      @unique @db.VarChar(320)
  phone                    String?                     @unique @db.VarChar(32)
  googleSubject            String?                     @unique @map("google_subject") @db.VarChar(255)
  passwordHash             String                      @map("password_hash")
  emailVerifiedAt          DateTime?                   @map("email_verified_at")
  identityVerification     IdentityVerificationStatus  @default(NOT_STARTED) @map("identity_verification_status")
  identityVerifiedAt       DateTime?                   @map("identity_verified_at")
  createdAt                DateTime                    @default(now()) @map("created_at")
  updatedAt                DateTime                    @updatedAt @map("updated_at")
  refreshSessions          RefreshSession[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  identityCases            IdentityVerificationCase[]
  serviceRequests          ServiceRequest[]
  providerResponses        ProviderResponse[]
  providerProfile          ProviderProfile?
  pushDevices              PushDevice[]
  notifications            AppNotification[]
  mediaAssets              MediaAsset[]

  @@index([identityVerification])
  @@map("users")
}

model RefreshSession {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid @map("user_id")
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerificationCase {
  id                    String                 @id @default(uuid()) @db.Uuid
  userId                String                 @db.Uuid @map("user_id")
  status                VerificationCaseStatus @default(SUBMITTED)
  provider              String?                @db.VarChar(80)
  providerReference     String?                @map("provider_reference") @db.VarChar(255)
  submittedAt           DateTime               @default(now()) @map("submitted_at")
  reviewedAt            DateTime?              @map("reviewed_at")
  reviewerId            String?                @db.Uuid @map("reviewer_id")
  decisionReason        String?                @map("decision_reason") @db.VarChar(1000)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("identity_verification_cases")
}

 
model ServiceRequest {
  id                 String                @id @default(uuid()) @db.Uuid
  seekerId           String                @db.Uuid @map("seeker_id")
  title              String                @db.VarChar(120)
  skillCategory      String                @map("skill_category") @db.VarChar(100)
  description        String                @db.VarChar(5000)
  imageUrls          String[]              @default([]) @map("image_urls")
  location           String?               @db.VarChar(500)
  deliveryMode       ServiceDeliveryMode   @map("delivery_mode")
  preferredStartAt   DateTime?             @map("preferred_start_at")
  instructions       String?               @db.VarChar(2000)
  status             ServiceRequestStatus  @default(OPEN)
  matchingWave       Int                   @default(0) @map("matching_wave")
  matchingNextAt     DateTime?             @map("matching_next_at")
  matchingExhaustedAt DateTime?            @map("matching_exhausted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  seeker             User                  @relation(fields: [seekerId], references: [id], onDelete: Restrict)
  providerResponses ProviderResponse[]
  matches           RequestMatch[]
  jobEngagement     JobEngagement?

  @@index([status, createdAt])
  @@index([seekerId, createdAt])
  @@map("service_requests")
}

model ProviderResponse {
  id          String                 @id @default(uuid()) @db.Uuid
  requestId   String                 @db.Uuid @map("request_id")
  providerId  String                 @db.Uuid @map("provider_id")
  status      ProviderResponseStatus @default(OFFERED)
  message     String?                @db.VarChar(2000)
  hourlyRateAtOffer Decimal?           @map("hourly_rate_at_offer") @db.Decimal(10, 2)
  assessmentFeeAtOffer Decimal?        @map("assessment_fee_at_offer") @db.Decimal(10, 2)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  request     ServiceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  provider    User                   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  jobEngagement JobEngagement?

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, status])
  @@map("provider_responses")
}

 
model ProviderProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid @map("user_id")
  publicName      String   @default("") @map("public_name") @db.VarChar(80)
  hourlyRate      Decimal? @map("hourly_rate") @db.Decimal(10, 2)
  assessmentFee   Decimal  @default(0) @map("assessment_fee") @db.Decimal(10, 2)
  skillCategories String[] @default([]) @map("skill_categories")
  serviceAreas    String[] @default([]) @map("service_areas")
  deliveryModes   String[] @default(["ONSITE"]) @map("delivery_modes")
  isAvailable     Boolean  @default(false) @map("is_available")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@map("provider_profiles")
}

model RequestMatch {
  id          String            @id @default(uuid()) @db.Uuid
  requestId   String            @db.Uuid @map("request_id")
  providerId  String            @db.Uuid @map("provider_id")
  score       Int
  wave        Int
  status      RequestMatchStatus @default(NOTIFIED)
  notifiedAt  DateTime          @default(now()) @map("notified_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  request     ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, providerId])
  @@index([providerId, status, createdAt])
  @@index([requestId, wave])
  @@map("request_matches")
}

model PushDevice {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid @map("user_id")
  expoPushToken String  @unique @map("expo_push_token") @db.VarChar(255)
  platform     String   @db.VarChar(30)
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model AppNotification {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid @map("user_id")
  title          String                    @db.VarChar(120)
  body           String                    @db.VarChar(500)
  data           Json?
  deliveryStatus NotificationDeliveryStatus @default(PENDING) @map("delivery_status")
  attempts       Int                       @default(0)
  readAt         DateTime?                 @map("read_at")
  sentAt         DateTime?                 @map("sent_at")
  createdAt      DateTime                  @default(now()) @map("created_at")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([deliveryStatus, createdAt])
  @@map("app_notifications")
}


model JobEngagement {
  id                    String              @id @default(uuid()) @db.Uuid
  requestId             String              @unique @db.Uuid @map("request_id")
  responseId            String              @unique @db.Uuid @map("response_id")
  seekerId              String              @db.Uuid @map("seeker_id")
  providerId            String              @db.Uuid @map("provider_id")
  status                JobEngagementStatus @default(ASSESSMENT_PENDING)
  hourlyRate            Decimal             @map("hourly_rate") @db.Decimal(10, 2)
  assessmentFee         Decimal             @default(0) @map("assessment_fee") @db.Decimal(10, 2)
  estimatedHours       Decimal?            @map("estimated_hours") @db.Decimal(8, 2)
  estimatedTotal       Decimal?            @map("estimated_total") @db.Decimal(10, 2)
  estimateNotes        String?             @map("estimate_notes") @db.VarChar(2000)
  estimateDecisionNote String?             @map("estimate_decision_note") @db.VarChar(1000)
  estimateSubmittedAt DateTime?            @map("estimate_submitted_at")
  estimateDecidedAt   DateTime?            @map("estimate_decided_at")
  workStartedAt       DateTime?            @map("work_started_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  request             ServiceRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  response            ProviderResponse     @relation(fields: [responseId], references: [id], onDelete: Restrict)
  adjustments         JobCostAdjustment[]
  completionSubmissions JobCompletionSubmission[]
  @@index([seekerId, status, createdAt])
  @@index([providerId, status, createdAt])
  @@map("job_engagements")
}

model JobCostAdjustment {
  id              String                @id @default(uuid()) @db.Uuid
  engagementId    String                @db.Uuid @map("engagement_id")
  requestedHours  Decimal               @map("requested_hours") @db.Decimal(8, 2)
  hourlyRate      Decimal               @map("hourly_rate") @db.Decimal(10, 2)
  requestedAmount Decimal               @map("requested_amount") @db.Decimal(10, 2)
  reason          String                @db.VarChar(1000)
  status          CostAdjustmentStatus  @default(PENDING)
  decisionNote    String?               @map("decision_note") @db.VarChar(1000)
  decidedAt       DateTime?             @map("decided_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  engagement      JobEngagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  @@index([engagementId, status, createdAt])
  @@map("job_cost_adjustments")
}


model JobCompletionSubmission {
  id             String                           @id @default(uuid()) @db.Uuid
  engagementId   String                           @db.Uuid @map("engagement_id")
  providerId     String                           @db.Uuid @map("provider_id")
  notes          String                           @db.VarChar(3000)
  evidenceUrls   String[]                         @default([]) @map("evidence_urls")
  evidenceAssets MediaAsset[]
  status         JobCompletionSubmissionStatus    @default(PENDING)
  reviewNote     String?                          @map("review_note") @db.VarChar(1000)
  submittedAt    DateTime                         @default(now()) @map("submitted_at")
  reviewedAt     DateTime?                        @map("reviewed_at")
  engagement     JobEngagement                    @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  @@index([engagementId, status, submittedAt])
  @@map("job_completion_submissions")
}


model MediaAsset {
  id                     String                       @id @default(uuid()) @db.Uuid
  userId                 String                       @db.Uuid @map("user_id")
  objectKey              String                       @unique @map("object_key") @db.VarChar(512)
  originalName            String                       @map("original_name") @db.VarChar(255)
  contentType             String                       @map("content_type") @db.VarChar(100)
  sizeBytes               Int                          @map("size_bytes")
  purpose                 String                       @db.VarChar(50)
  status                  MediaAssetStatus             @default(PENDING)
  expiresAt               DateTime                     @map("expires_at")
  uploadedAt              DateTime?                    @map("uploaded_at")
  completionSubmissionId  String?                      @db.Uuid @map("completion_submission_id")
  createdAt               DateTime                     @default(now()) @map("created_at")
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  completionSubmission    JobCompletionSubmission?     @relation(fields: [completionSubmissionId], references: [id], onDelete: SetNull)
  @@index([userId, status, expiresAt])
  @@index([completionSubmissionId])
  @@map("media_assets")
}
